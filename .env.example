# PostgreSQL connection used by the FastAPI API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/examslot
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Leave SMTP_HOST empty for local development; setup links are returned by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@examslot.local
